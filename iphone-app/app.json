{
  "expo": {
    "name": "Dark Case Audio",
    "slug": "dark-case-audio",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "darkcaseaudio",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darkcaseproductions.darkcaseaudio"
    },
    "android": {
      "package": "com.darkcaseproductions.darkcaseaudio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090c"
      },
      "versionCode": 2,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "buildToolsVersion": "36.0.0"
    },
    "web": {
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ]
  }
}
